<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Supports all current versions -->
        <!-- https://learn.microsoft.com/en-us/dotnet/standard/frameworks#latest-version -->
        <!-- and .NET Standard 2.0 (so this library may be referenced by Source Generators) -->
        <!-- and some out of support frameworks caught in the middle of features -->
        <TargetFrameworks>
            net9.0;net8.0;net7.0;net6.0;net5.0;
            netstandard2.1;netstandard2.0;
            net481;
        </TargetFrameworks>
        <CheckEolTargetFramework>false</CheckEolTargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <AssemblyName>ScrubJay.Reflection</AssemblyName>
        <RootNamespace>ScrubJay.Reflection</RootNamespace>
    </PropertyGroup>

    <!-- Expose our internals to our tests and other trusted ScrubJay libraries -->
    <ItemGroup>
        <InternalsVisibleTo Include="ScrubJay.Reflection.Tests"/>
        <InternalsVisibleTo Include="ScrubJay.Reflection.Sandbox"/>
        <InternalsVisibleTo Include="ScrubJay.Reflection.Benchmarks"/>
    </ItemGroup>

    <!-- Global Usings -->
    <ItemGroup>
        <Using Include="System.Collections"/>
        <Using Include="System.ComponentModel"/>
        <Using Include="System.Diagnostics"/>
        <Using Include="System.Diagnostics.CodeAnalysis"/>
        <Using Include="System.Numerics"/>
        <Using Include="System.Reflection"/>
        <Using Include="System.Reflection.Emit"/>
        <Using Include="System.Runtime.CompilerServices"/>
        <Using Include="System.Runtime.InteropServices"/>

        <Using Include="JetBrains.Annotations"/>

        <Using Include="ScrubJay.Prelude" Static="true"/>
        <Using Include="ScrubJay.Functional"/>
        <Using Include="ScrubJay.Building"/>
        <Using Include="ScrubJay.Text"/>
        <Using Include="ScrubJay.Enums"/>
        <Using Include="ScrubJay.Extensions"/>
        <Using Include="ScrubJay.Validation"/>

        <Using Include="ScrubJay.Reflection.Extensions"/>
        <Using Include="ScrubJay.Reflection.Utilities"/>


    </ItemGroup>

    <!-- NuGet Packages -->
    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0"/>
        <PackageReference Include="ScrubJay.Core" Version="0.51.0-alpha" />

        <PackageReference Include="Fody" Version="6.9.2">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="InlineIL.Fody" Version="1.10.1">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.0">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <!-- Need System.Memory for older frameworks -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net481' Or '$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == 'netstandard2.1'">
        <PackageReference Include="System.Memory" Version="4.6.3"/>
        <PackageReference Include="System.Text.Json" Version="9.0.8"/>
    </ItemGroup>

    <!-- And additional packages for NetStandard 2.0 -->
    <ItemGroup Condition=" '$(TargetFramework)' == 'netstandard2.0' ">
        <PackageReference Include="System.Reflection.Emit" Version="4.7.0">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="System.Reflection.Emit.ILGeneration" Version="4.7.0">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="System.Reflection.Emit.Lightweight" Version="4.7.0">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

</Project>
