<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <AssemblyName>ScrubJay.Reflection.ConsoleApp</AssemblyName>
        <RootNamespace>ScrubJay.Reflection.ConsoleApp</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Using Include="ScrubJay.Extensions" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\src\ScrubJay.Reflection.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="ScrubJay.Core" Version="0.40.3-alpha" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.12.0">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

</Project>