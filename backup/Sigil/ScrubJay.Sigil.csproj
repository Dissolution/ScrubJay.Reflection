<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>
      net9.0;net8.0;net7.0;net6.0;net5.0;
      netcoreapp3.1;
      netstandard2.1;netstandard2.0;
      net481;
    </TargetFrameworks>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>

    <!-- Always use the latest features -->
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>

    <AssemblyName>ScrubJay.Sigil</AssemblyName>
    <RootNamespace>ScrubJay.Sigil</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.Reflection"/>
    <Using Include="System.Reflection.Emit"/>
    <Using Include="System.Text"/>
    
    <Using Include="ScrubJay.Sigil.Impl"/>
    <Using Include="JetBrains.Annotations"/>
    
    <Using Include="ScrubJay.Functional"/>
    <Using Include="ScrubJay.Functional.Prelude" Static="true"/>
  </ItemGroup>

